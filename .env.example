# Discord application (create at https://discord.com/developers/applications)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_TEST_GUILD_ID=
DISCORD_REDIRECT_URI=http://localhost:8080/api/auth/discord/callback

# Public dashboard / API
DASHBOARD_URL=http://localhost:5173
API_BASE_URL=http://localhost:8080
PORT=8080
COOKIE_SECRET=replace-with-32-random-characters

# Firebase / Google Cloud
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_SERVICE_ACCOUNT_JSON=

# AI: choose gemini (recommended free tier), nvidia, or openai-compatible
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
NVIDIA_API_KEY=
NVIDIA_MODEL=openai/gpt-oss-120b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Optional development switches
LOG_LEVEL=info
